<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
  class="{% if request.page_type == 'index' %}valor-page-index{% endif %}"
  data-valor-theme="valor"
>
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS before any optional font preload %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% comment %}
      Keep resource hints focused: critical.css is already preloaded above and,
      when needed, only the base body font is preloaded for first paint.
      Additional font variants load through @font-face with font-display: swap.
    {% endcomment %}
    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {%- if settings.enable_back_to_top -%}
      {{ 'back-to-top.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if settings.enable_predictive_search -%}
      {{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {{ 'product-media-gallery.css' | asset_url | stylesheet_tag }}
    {{ 'lightbox.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- comment -%}
      Shopify standard storefront events and actions. The module exposes the
      Shopify-hosted events library as window.StandardEvents.
      storefront-events.js then wires the theme's own dispatches, configures
      Shopify.actions and, once shopify:page:view has been dispatched on
      DOMContentLoaded, registers <valor-view-event> (the element that
      dispatches product / collection / cart view events from payloads
      rendered by the standard_event_data filter). Registering it no earlier
      guarantees that every deferred script, including slow app scripts, has
      run and subscribed before the first view event fires. Module and deferred scripts execute in
      document order, so every body script below can rely on
      window.ValorEvents.

      The inline ValorBoot script is synchronous on purpose: it registers the
      theme's DOMContentLoaded listener while <head> is still being parsed,
      before any script in content_for_header can register one. Work that
      storefront-events.js queues on it (configuring Shopify.actions, the
      shopify:page:view dispatch) runs in that first listener, so the theme's
      action configuration always wins (only the first configure() counts).
    {%- endcomment -%}
    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';

      window.StandardEvents = StandardEvents;
    </script>
    <script src="{{ 'storefront-events.js' | asset_url }}" defer></script>
    <script>
      window.ValorBoot = window.ValorBoot || { ready: false, queue: [] };
      document.addEventListener(
        'DOMContentLoaded',
        function () {
          var boot = window.ValorBoot;
          boot.ready = true;
          var queue = boot.queue.splice(0);
          for (var i = 0; i < queue.length; i++) {
            try {
              queue[i]();
            } catch (error) {
              console.error('[Valor] ready callback failed', error);
            }
          }
        },
        { once: true }
      );
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="valor-skip-to-content-link" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1" data-template="{{ template.name }}">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.enable_cart_drawer -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- comment -%}
      Add-to-cart AJAX is always loaded, decoupled from the drawer. When the
      drawer is disabled it still intercepts add-to-cart, then navigates to the
      cart page, matching Dawn/Horizon "page" cart mode.
    {%- endcomment -%}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

    {%- if settings.enable_back_to_top -%}
      {%- render 'back-to-top' -%}
      <script src="{{ 'back-to-top.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- if settings.enable_predictive_search -%}
      <script>
        window.routes = window.routes || {};
        window.routes.predictive_search_url = {{ routes.predictive_search_url | json }};
      </script>
      <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- if request.page_type == 'index' -%}
      <script>
        (function () {
          requestAnimationFrame(function () {
            if (
              !document.querySelector(
                '#MainContent > .shopify-section:first-child .valor-transparent-header-trigger',
              )
            ) {
              document.documentElement.classList.add('valor-transparent-header-ready');
            }
          });
        })();
      </script>
    {%- endif -%}

    {%- render 'legal-guarantee-notice', mode: 'dialog' -%}

    {%- render 'lightbox' -%}
    <script src="{{ 'lightbox.js' | asset_url }}" defer></script>
    <script src="{{ 'product-media-gallery.js' | asset_url }}" defer></script>
    <script src="{{ 'quantity-input.js' | asset_url }}" defer></script>
    <script src="{{ 'video.js' | asset_url }}" defer></script>
    <script src="{{ 'product-card.js' | asset_url }}" defer></script>
  </body>
</html>
