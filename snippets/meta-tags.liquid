<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # Resolve a preview image for og:image so social sharing and the
  # native Web Share API show a thumbnail. Each page type falls back
  # to its primary image; pages without one render no og:image, which
  # the platform handles by showing the site name only.
  if request.page_type == 'product' and product.featured_image
    assign page_image = product.featured_image
  elsif request.page_type == 'collection' and collection.image
    assign page_image = collection.image
  elsif request.page_type == 'article' and article.image
    assign page_image = article.image
  elsif request.page_type == 'page' and page.image
    assign page_image = page.image
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  {%- comment -%}
    image_url requires a width/height. Cap the request at the image's
    native width so we never claim an upscaled size, and report the
    matching proportional height so crawlers get accurate dimensions.
  {%- endcomment -%}
  {%- assign og_image_width = 1200 -%}
  {%- if page_image.width < og_image_width -%}
    {%- assign og_image_width = page_image.width -%}
  {%- endif -%}
  {%- assign og_image_height = page_image.height | times: og_image_width | divided_by: page_image.width -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url: width: og_image_width }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image_width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image_height }}"
  >
{%- endif -%}

{%- render 'structured-data' -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    Open Graph expects a raw decimal (e.g. 12.99), not a locale-formatted
    string — money_without_currency would emit "1.299,00" in EU locales,
    which breaks parsing. price is in the currency's minor units.
  {%- endcomment -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | divided_by: 100.0 }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags -%}
    {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tagged' | t: tags: meta_tags -}}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if settings.favicon != blank -%}
  <link
    rel="icon"
    type="image/png"
    href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
  >
  <link
    rel="apple-touch-icon"
    href="{{ settings.favicon | image_url: width: 180, height: 180 }}"
  >
{%- endif -%}

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
